# OpenRouter API key — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: which OpenRouter model to use (default: openai/gpt-4o)
# Other GPT-4 options: openai/gpt-4-turbo, openai/gpt-4
OPENROUTER_MODEL=openai/gpt-4o

# Optional: shown on OpenRouter dashboard for leaderboard/attribution
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=ColdReach Intel

# Apify API token for live Google/LinkedIn search grounding.
# Get one at https://console.apify.com/account/integrations
APIFY_API_TOKEN=apify_api_your_token_here

# --- Job Finder (/jobs) ---
# Anthropic Claude API key for ranking job postings against your CV.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: which Claude model to use (default: claude-sonnet-4-6).
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Apify key for the Job Finder. Falls back to APIFY_API_TOKEN above if unset.
# APIFY_API_KEY=apify_api_your_token_here
